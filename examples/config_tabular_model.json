{
  "task": "tabular",
  "data": "demo",
  "label_col": "cause_of_death",
  "output_dir": "runs/json/tabular_lightgbm",
  "features": "re:^i\\d{3}[a-zA-Z]$",
  "model": "lightgbm",
  "encode_categoricals": "ordinal",
  "hyperparams": {
    "optimize": {
      "metric": "f1_macro",
      "n_trials": 40
    }
  },
  "test_size": 0.2,
  "split_seed": 42,
  "train_seed": 42,
  "top_k": 3
}
